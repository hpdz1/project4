# Package Radar environment variables.
# Copy to .env.local for local development (it is gitignored) and fill in what you need.
# Every variable is optional; the defaults below are what you get when it is unset.

# ---------------------------------------------------------------------------
# Public site settings (NEXT_PUBLIC_*). These are inlined into the build:
# change them, then rebuild (`npm run build`) for them to take effect.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap.xml and robots.txt, e.g. https://packageradar.example.com
# http(s) only, no trailing slash. Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Address shown on the contact, privacy and terms pages. Default: hello@example.com
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Operator identity (the "controller" named in /privacy and /terms) -------
# Privacy laws in many countries (GDPR/UK GDPR, Japan's APPI, Korea's PIPA,
# Quebec's Law 25, ...) expect the policy to say who runs the service and how
# to reach them. Fill these in before you launch.
# In development builds, /privacy and /terms show clearly marked placeholder
# notes for unset values; production builds show only what is set.

# Legal name of the person or company that runs the site, e.g. "Example Labs Ltd".
# Default: "the operator of Package Radar"
NEXT_PUBLIC_OPERATOR_NAME=

# Postal address for legal and privacy contact, on one line with commas,
# e.g. "Example Labs Ltd, 1 Sample Street, London EC1A 1AA, United Kingdom".
# A company or registered-agent address avoids publishing a home address.
# Default: unset (no address shown in production)
NEXT_PUBLIC_OPERATOR_ADDRESS=

# Country where the operator is established. A two-letter ISO code ("DE", "GB",
# "US") is shown as the country name; free text is shown as typed
# (e.g. "the State of Delaware, United States"). Also used as the governing law
# in /terms. Default: unset
NEXT_PUBLIC_OPERATOR_COUNTRY=

# GDPR Art. 27 / UK GDPR Art. 27 representatives, needed when the operator is
# established outside the EU / UK. Free text: name, postal address, email.
# Shown on /privacy only when set. Default: unset
NEXT_PUBLIC_EU_REPRESENTATIVE=
NEXT_PUBLIC_UK_REPRESENTATIVE=

# Address for privacy and data requests. Default: NEXT_PUBLIC_CONTACT_EMAIL
NEXT_PUBLIC_PRIVACY_EMAIL=

# Google AdSense client id ("ca-pub-" + digits). Unset = no ads and /ads.txt is a 404.
# Ads only load in production builds.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Numeric AdSense ad-unit ids for each manual placement. Unset = no ad in that spot.
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=

# "1" shows dashed "Ad placeholder" boxes where ads would go (development only).
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=

# ---------------------------------------------------------------------------
# Server settings, read at runtime (a restart is enough after a change).
# ---------------------------------------------------------------------------

# Domain of the personal forwarding addresses (r-xxxxxxxxxxxxxxxx@<INBOUND_DOMAIN>).
# It must be the domain your inbound provider (Cloudflare Email Routing or Postmark)
# receives mail for. Default: inbound.localhost
INBOUND_DOMAIN=

# Shared secret for the inbound email webhooks. Unset or blank = inbound email is
# DISABLED (/api/inbound/* answer 503 inbound_disabled). Use a long random value,
# e.g. `openssl rand -base64 32`.
#   Postmark:   https://postmark:<INBOUND_SECRET>@<your site>/api/inbound/postmark  (Basic auth password)
#   Worker/raw: Authorization: Bearer <INBOUND_SECRET>  ->  /api/inbound/raw
INBOUND_SECRET=

# SQLite database file (node:sqlite). Needs a persistent disk and a single app instance.
# ":memory:" = throwaway database. Default: .data/package-radar.db
DATABASE_PATH=

# "1" enables demo mode: POST /api/demo/seed loads sample carrier emails into the
# signed-in account. "0" disables it. Default: on when NODE_ENV=development, else off.
DEMO_MODE=

# REQUIRED ("1") whenever the app runs behind a reverse proxy / load balancer
# (Railway, Fly, Render, nginx, Caddy, Cloudflare, ...). Without it, sign-in and
# other state-changing requests can fail the same-origin check, and every visitor
# shares one rate-limit bucket. With it, the client IP for rate limiting is the
# right-most X-Forwarded-For entry and the same-origin check uses X-Forwarded-Host.
# Leave unset only when clients connect directly: forwarding headers are then
# ignored (they could be forged) and all clients share one rate-limit bucket
# (10 new accounts and 20 sign-ins per hour in total).
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Set by the tooling, not by you
# ---------------------------------------------------------------------------
# NODE_ENV  - "development" under `next dev`, "production" under `next build`/`next start`.
#             Production turns on Secure cookies and real AdSense.
# CI        - Playwright reuses an already running server unless CI is set.
# E2E_PORT  - port for the Playwright test server (default 3100).
#
# Optional: Node 22 prints "ExperimentalWarning: SQLite is an experimental feature"
# once per process. To hide it: NODE_OPTIONS=--disable-warning=ExperimentalWarning
